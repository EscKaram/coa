@startuml a-c4-container
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()

title Вариант 1. Собственный оркестратор доставки: Kafka + PostgreSQL (C4 Container)

Person(client, "Клиент банка", "Мобильное приложение с SDK подтверждения push")
Person(support, "Сотрудник поддержки", "Разбирает жалобы «не пришло»")

System_Ext(producers, "Продуктовые сервисы", "Платежи, переводы, карты. Transactional outbox")
System_Ext(pushp, "Push-провайдеры", "APNs, FCM, RuStore Push")
System_Ext(smsA, "SMS-провайдер A", "Основной по цене")
System_Ext(smsB, "SMS-провайдер B", "Резервный")
System_Ext(esp, "Email-провайдер", "ESP + собственный SMTP-релей")

System_Boundary(np, "Notification Platform: подсистема гарантированной доставки") {
  Container(api, "Notification API", "Python 3.12, FastAPI + gRPC", "Синхронный приём для сервисов без outbox. Ответ 202 после записи в Kafka (acks=all)")
  ContainerQueue(kafka, "Kafka", "Apache Kafka 3.7, KRaft, 3 AZ, RF=3", "ntf.tx.requests, ntf.tx.events, ntf.cmd.push.tx / sms.tx / email.tx, ntf.status")
  Container(orch, "Delivery Orchestrator", "Python 3.12, confluent-kafka, asyncpg", "Дедупликация, план каналов, переходы автомата (CAS по version), outbox")
  Container(timer, "Timer Worker", "Python 3.12, asyncpg", "Дедлайны: SELECT ... FOR UPDATE SKIP LOCKED, переход по таймауту, сверка зависших")
  ContainerDb(db, "Delivery DB", "PostgreSQL 16, Patroni, синхронная реплика в другой AZ", "notification, delivery_attempt, ntf_dedup, outbox. Секции по дням")
  Container(relay, "Outbox Relay", "Debezium 2.7 на Kafka Connect", "CDC из WAL: outbox в Kafka")
  Container(pushS, "Push Sender", "Python 3.12, httpx HTTP/2", "collapse-id, повторы в бюджете 2 с")
  Container(smsS, "SMS Sender", "Python 3.12, httpx", "Маршрутизация A/B, circuit breaker, rate limit, флаг отмены")
  Container(emailS, "Email Sender", "Python 3.12, aiosmtplib, HTTP API", "Последний резервный канал")
  Container(rc, "Receipt Collector", "Python 3.12, FastAPI", "DLR, события email, ack из приложения")
  Container(pref, "Preference Service", "Python 3.12, FastAPI", "Настройки, согласия, контакты, push-токены, достижимость")
  ContainerDb(prefdb, "Preference DB", "PostgreSQL 16", "Источник истины настроек и контактов")
  ContainerDb(redis, "Redis", "Redis 7.4 Cluster", "Кеш настроек, rate limit, флаги отмены, provider_message_id")
  ContainerDb(ch, "Delivery Analytics", "ClickHouse 24", "История переходов, отчёты, стоимость SMS")
  Container(console, "Support Console", "Web UI", "История уведомления по id или клиенту")
  Container(obs, "Observability", "OTel Collector, Prometheus, Grafana, Tempo, Loki", "SLO, алерты, трейсы. Метрики и трейсы шлют все контейнеры")
}

Rel(producers, kafka, "NotificationRequested", "Kafka, outbox продюсера")
Rel(producers, api, "SendNotification", "gRPC, mTLS")
Rel(api, kafka, "Публикует запрос", "acks=all")
Rel(kafka, orch, "Запросы, результаты попыток, подтверждения")
Rel(orch, redis, "Настройки и контакты", "RESP")
Rel(orch, pref, "Промах кеша", "HTTP")
Rel(pref, prefdb, "Чтение и запись", "SQL")
Rel(orch, db, "Состояние + outbox в одной транзакции", "SQL")
Rel(timer, db, "Дедлайны, переходы по таймауту", "SQL")
Rel(relay, db, "Читает WAL", "logical decoding")
Rel(relay, kafka, "Команды и статусы")
Rel(kafka, pushS, "ntf.cmd.push.tx")
Rel(kafka, smsS, "ntf.cmd.sms.tx")
Rel(kafka, emailS, "ntf.cmd.email.tx")
Rel(pushS, kafka, "AttemptSubmitted / Failed")
Rel(smsS, kafka, "AttemptSubmitted / Failed")
Rel(emailS, kafka, "AttemptSubmitted / Failed")
Rel(smsS, redis, "Rate limit, флаг отмены")
Rel(pushS, pushp, "Отправка", "HTTP/2")
Rel(smsS, smsA, "Отправка", "HTTPS")
Rel(smsS, smsB, "Отправка при отказе A", "HTTPS")
Rel(emailS, esp, "Отправка", "HTTPS / SMTP")
Rel(pushp, client, "Push")
Rel(client, rc, "ack доставки", "HTTPS через Mobile API Gateway")
Rel(smsA, rc, "DLR", "HTTPS webhook")
Rel(smsB, rc, "DLR", "HTTPS webhook")
Rel(esp, rc, "delivered / bounce", "HTTPS webhook")
Rel(rc, kafka, "ReceiptReceived")
Rel(kafka, ch, "ntf.status", "Kafka engine")
Rel(support, console, "Ищет уведомление")
Rel(console, ch, "История")
Rel(console, db, "Текущее состояние", "SQL, реплика")

SHOW_LEGEND()
@enduml
