@startuml b-c4-container
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()

title Вариант 2. Workflow-движок Temporal (C4 Container)

Person(client, "Клиент банка", "Мобильное приложение с SDK подтверждения push")
Person(support, "Сотрудник поддержки", "Разбирает жалобы «не пришло»")

System_Ext(producers, "Продуктовые сервисы", "Платежи, переводы, карты. Transactional outbox")
System_Ext(pushp, "Push-провайдеры", "APNs, FCM, RuStore Push")
System_Ext(smsA, "SMS-провайдер A", "Основной по цене")
System_Ext(smsB, "SMS-провайдер B", "Резервный")
System_Ext(esp, "Email-провайдер", "ESP + собственный SMTP-релей")

System_Boundary(np, "Notification Platform: подсистема гарантированной доставки") {
  Container(api, "Notification API", "Python 3.12, FastAPI + gRPC", "Синхронный приём для сервисов без outbox. Ответ 202 после записи в Kafka")
  ContainerQueue(kafka, "Kafka", "Apache Kafka 3.7, KRaft, 3 AZ, RF=3", "ntf.tx.requests, ntf.receipts, ntf.status")
  Container(starter, "Workflow Starter", "Python 3.12, temporalio", "Kafka → StartWorkflow(id = notification_id). Offset коммитится после ответа Temporal")
  Container(temporal, "Temporal Server", "Temporal 1.25: frontend, history, matching", "Надёжные таймеры, история workflow, очереди задач")
  ContainerDb(cass, "Temporal Persistence", "Apache Cassandra 4.1, 3 AZ, RF=3", "История workflow, таймеры, очереди задач")
  ContainerDb(os, "Temporal Visibility", "OpenSearch 2", "Поиск workflow по атрибутам")
  Container(wfw, "Delivery Workflow Worker", "Python 3.12, temporalio", "TxDeliveryWorkflow, activity build_plan и publish_status")
  Container(pushW, "Push Activity Worker", "Python 3.12, temporalio, httpx HTTP/2", "task queue push: activity send, collapse-id")
  Container(smsW, "SMS Activity Worker", "Python 3.12, temporalio, httpx", "task queue sms: маршрутизация A/B, circuit breaker, rate limit")
  Container(emailW, "Email Activity Worker", "Python 3.12, temporalio, aiosmtplib", "task queue email: последний резервный канал")
  Container(rc, "Receipt Collector", "Python 3.12, FastAPI", "DLR, события email, ack из приложения → ntf.receipts")
  Container(sig, "Receipt Signaler", "Python 3.12, temporalio", "ntf.receipts → SignalWorkflow; сигнал в завершённый workflow = late ack")
  Container(pref, "Preference Service", "Python 3.12, FastAPI, PostgreSQL 16", "Настройки, согласия, контакты, push-токены, достижимость")
  ContainerDb(redis, "Redis", "Redis 7.4 Cluster", "Кеш настроек, rate limit провайдеров")
  ContainerDb(ch, "Delivery Analytics", "ClickHouse 24", "Бизнес-история, отчёты, стоимость SMS")
  Container(console, "Support Console", "Web UI + Temporal Web UI", "История уведомления и workflow")
  Container(obs, "Observability", "OTel Collector, Prometheus, Grafana, Tempo, Loki", "SLO, алерты, трейсы. Метрики SDK и Temporal Server")
}

Rel(producers, kafka, "NotificationRequested", "Kafka, outbox продюсера")
Rel(producers, api, "SendNotification", "gRPC, mTLS")
Rel(api, kafka, "Публикует запрос", "acks=all")
Rel(kafka, starter, "ntf.tx.requests")
Rel(starter, temporal, "StartWorkflow", "gRPC")
Rel(temporal, cass, "История, таймеры", "CQL")
Rel(temporal, os, "Visibility")
Rel(wfw, temporal, "Workflow и activity tasks", "gRPC long poll")
Rel(pushW, temporal, "Activity tasks, очередь push", "gRPC long poll")
Rel(smsW, temporal, "Activity tasks, очередь sms", "gRPC long poll")
Rel(emailW, temporal, "Activity tasks, очередь email", "gRPC long poll")
Rel(wfw, redis, "build_plan: настройки", "RESP")
Rel(wfw, pref, "Промах кеша", "HTTP")
Rel(wfw, kafka, "publish_status → ntf.status")
Rel(smsW, redis, "Rate limit")
Rel(pushW, pushp, "Отправка", "HTTP/2")
Rel(smsW, smsA, "Отправка", "HTTPS")
Rel(smsW, smsB, "Отправка при отказе A", "HTTPS")
Rel(emailW, esp, "Отправка", "HTTPS / SMTP")
Rel(pushp, client, "Push")
Rel(client, rc, "ack доставки", "HTTPS через Mobile API Gateway")
Rel(smsA, rc, "DLR", "HTTPS webhook")
Rel(smsB, rc, "DLR", "HTTPS webhook")
Rel(esp, rc, "delivered / bounce", "HTTPS webhook")
Rel(rc, kafka, "ntf.receipts")
Rel(kafka, sig, "ntf.receipts")
Rel(sig, temporal, "SignalWorkflow(notification_id)", "gRPC")
Rel(kafka, ch, "ntf.status", "Kafka engine")
Rel(support, console, "Ищет уведомление")
Rel(console, ch, "Бизнес-история")
Rel(console, temporal, "История workflow")

SHOW_LEGEND()
@enduml
