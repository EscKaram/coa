{
  "uid": "online-cinema",
  "title": "Online Cinema — аналитика",
  "description": "Агрегаты сервиса агрегации (ClickHouse, cinema.agg_*). Время — UTC.",
  "tags": [
    "cinema",
    "clickhouse"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Retention Cohort Heatmap",
      "description": "Когорта — день первой активности пользователя (UTC). Day N — доля пользователей когорты, активных на N-й день. Пустая ячейка — день ещё не наступил. Источник: cinema.agg_retention_cohort (сервис агрегации).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    cohort_date AS \"Когорта\",\n    max(cohort_size) AS \"Пользователей\",\n    maxIf(toNullable(retention_rate), day_number = 0) AS \"Day 0\",\n    maxIf(toNullable(retention_rate), day_number = 1) AS \"Day 1\",\n    maxIf(toNullable(retention_rate), day_number = 2) AS \"Day 2\",\n    maxIf(toNullable(retention_rate), day_number = 3) AS \"Day 3\",\n    maxIf(toNullable(retention_rate), day_number = 4) AS \"Day 4\",\n    maxIf(toNullable(retention_rate), day_number = 5) AS \"Day 5\",\n    maxIf(toNullable(retention_rate), day_number = 6) AS \"Day 6\",\n    maxIf(toNullable(retention_rate), day_number = 7) AS \"Day 7\"\nFROM cinema.agg_retention_cohort FINAL\nWHERE $__dateFilter(cohort_date)\nGROUP BY cohort_date\nORDER BY cohort_date DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Day [0-7]$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Когорта"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Пользователей"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.align",
                "value": "center"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DAU",
      "description": "Уникальные пользователи за день (UTC), метрика dau.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toDateTime(metric_date) AS time, value AS \"DAU\"\nFROM cinema.agg_daily_metrics FINAL\nWHERE metric_name = 'dau' AND $__dateFilter(metric_date)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Конверсия просмотра",
      "description": "VIEW_FINISHED / VIEW_STARTED за день, метрика view_conversion.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toDateTime(metric_date) AS time, value AS \"Конверсия\"\nFROM cinema.agg_daily_metrics FINAL\nWHERE metric_name = 'view_conversion' AND $__dateFilter(metric_date)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "decimals": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Retention D1 / D7",
      "description": "Метрика дня D: доля когорты D-1 (D-7), активной в день D.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    toDateTime(metric_date) AS time,\n    maxIf(value, metric_name = 'retention_d1') AS \"D1\",\n    maxIf(value, metric_name = 'retention_d7') AS \"D7\"\nFROM cinema.agg_daily_metrics FINAL\nWHERE metric_name IN ('retention_d1', 'retention_d7') AND $__dateFilter(metric_date)\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "decimals": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Среднее время просмотра, мин",
      "description": "Средний progress_seconds у VIEW_FINISHED за день (метрика avg_watch_time_seconds), переведён в минуты: / 60.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toDateTime(metric_date) AS time, round(value / 60, 1) AS \"Минут\"\nFROM cinema.agg_daily_metrics FINAL\nWHERE metric_name = 'avg_watch_time_seconds' AND $__dateFilter(metric_date)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Топ-10 фильмов по просмотрам за период",
      "description": "Сумма VIEW_STARTED по дневным рейтингам cinema.agg_top_movies за выбранный период.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT movie_id AS \"Фильм\", sum(views) AS \"Просмотров\"\nFROM cinema.agg_top_movies FINAL\nWHERE $__dateFilter(metric_date)\nGROUP BY movie_id\nORDER BY \"Просмотров\" DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [],
          "fields": "/^Просмотров$/",
          "values": true
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Просмотры и досмотры",
      "description": "Число VIEW_STARTED и VIEW_FINISHED за день.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    toDateTime(metric_date) AS time,\n    maxIf(value, metric_name = 'views_started') AS \"VIEW_STARTED\",\n    maxIf(value, metric_name = 'views_finished') AS \"VIEW_FINISHED\"\nFROM cinema.agg_daily_metrics FINAL\nWHERE metric_name IN ('views_started', 'views_finished') AND $__dateFilter(metric_date)\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
