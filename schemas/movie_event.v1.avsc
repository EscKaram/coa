{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "cinema.events",
  "doc": "Действие пользователя онлайн-кинотеатра. Версия 1: обязательные поля из условия.",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Уникальный идентификатор события"},
    {"name": "user_id", "type": "string", "doc": "Идентификатор пользователя; ключ партиционирования"},
    {"name": "movie_id", "type": "string", "doc": "Идентификатор фильма"},
    {"name": "event_type", "type": {"type": "enum", "name": "EventType",
      "symbols": ["VIEW_STARTED", "VIEW_FINISHED", "VIEW_PAUSED", "VIEW_RESUMED", "LIKED", "SEARCHED"]}},
    {"name": "timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Время события, UTC, миллисекунды от Unix epoch"},
    {"name": "device_type", "type": {"type": "enum", "name": "DeviceType",
      "symbols": ["MOBILE", "DESKTOP", "TV", "TABLET"]}},
    {"name": "session_id", "type": "string", "doc": "Идентификатор сессии просмотра"},
    {"name": "progress_seconds", "type": ["null", "int"], "default": null,
      "doc": "Позиция воспроизведения в секундах; есть только у событий VIEW_*"}
  ]
}
